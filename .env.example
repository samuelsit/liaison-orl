# ─────────────────────────────────────────────────────────────────────────────
# LIAISON ORL — variables d'environnement
# Copiez ce fichier en .env.local (développement) ou saisissez ces variables
# dans Vercel (Settings → Environment Variables).
# Tout service dont la clé est absente passe automatiquement en MODE DÉMO
# (simulation, aucun envoi réel) et un bandeau « Mode démo » s'affiche dans l'admin.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'application (sans / final). Sert aux liens envoyés par e-mail,
# aux cookies sécurisés et à la vérification d'origine. Sur Vercel, VERCEL_URL est
# utilisé par défaut mais définissez votre domaine définitif en production.
APP_URL=http://localhost:3000

# ── Base de données : MongoDB Atlas (région UE, accès réseau restreint) ─────────
# En développement, `npm run demo` démarre une base locale embarquée (port 27027)
# et cette variable peut rester vide.
MONGODB_URI=
# Nom de la base (facultatif : déduit de l'URI, sinon « liaison-orl »).
MONGODB_DB=

# ── Authentification (Better Auth) ─────────────────────────────────────────────
# OBLIGATOIRE en production : 32 caractères aléatoires minimum.
# Générez-en un avec :  openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── IA : API Anthropic ─────────────────────────────────────────────────────────
# Absente → réponses fictives réalistes (mode démo).
ANTHROPIC_API_KEY=
# Modèles (modifiables sans redéployer de code).
AI_MODEL_VISION=claude-sonnet-5-5
AI_MODEL_TEXT=claude-haiku-5-5
# Facultatif : géographie d'inférence (paramètre `inference_geo` de l'API), si votre contrat le prévoit.
AI_INFERENCE_GEO=

# ── E-mail : Resend ────────────────────────────────────────────────────────────
# Absente → e-mails simulés, consultables dans Administration → Boîte d'envoi (démo).
RESEND_API_KEY=
# Secret de signature du webhook Resend (commence par whsec_).
RESEND_WEBHOOK_SECRET=
# Domaine vérifié chez Resend (SPF, DKIM, DMARC) et adresse d'expédition technique.
# Le nom affiché est celui du centre ; les réponses vont à l'e-mail du centre.
EMAIL_FROM_DOMAIN=
EMAIL_FROM_ADDRESS=

# ── Courrier postal : Pingen (API v2) ──────────────────────────────────────────
# Absentes → courriers simulés avec statuts qui évoluent.
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANISATION_ID=
# staging | production. « production » n'est pris en compte QUE si l'application
# tourne en production réelle (NODE_ENV=production et VERCEL_ENV=production).
PINGEN_ENV=staging
# Clé de signature choisie à la création des webhooks Pingen (20 à 32 caractères).
PINGEN_WEBHOOK_SECRET=

# ── Fichiers : AWS S3 (bucket privé, eu-west-3 Paris, chiffrement SSE) ─────────
# Absentes → disque local (.data/storage) en développement, GridFS sur Vercel.
S3_BUCKET=
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Uniquement pour un stockage compatible S3 (laisser vide pour AWS).
S3_ENDPOINT=

# ── Tâches planifiées (Vercel Cron) ────────────────────────────────────────────
# Vercel envoie « Authorization: Bearer <CRON_SECRET> » aux routes /api/cron/*.
CRON_SECRET=

# ── Divers ─────────────────────────────────────────────────────────────────────
# Dossier du stockage local (développement).
LOCAL_STORAGE_DIR=.data/storage
# 1 = afficher les comptes et le code TOTP de démonstration sur l'écran de connexion
# (par défaut : uniquement en développement). NE JAMAIS activer en production réelle.
DEMO_LOGIN_HINTS=
# 1 = désactiver la limitation de débit de l'authentification (tests E2E uniquement).
DISABLE_RATE_LIMIT=
